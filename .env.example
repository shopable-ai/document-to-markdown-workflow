# Post-merge Markdown formatting is opt-in. Copy this file to .env and review it.
MARKDOWN_FORMATTER_MODE=model-optional
MARKDOWN_FORMATTER_ROUTE=auto
MARKDOWN_FORMATTER_TIMEOUT_SECONDS=300
MARKDOWN_FORMATTER_MAX_CHARS=12000

# Default auto route: LAN Ollama first, then a fresh Codex CLI run using the
# current machine's default/profile configuration.
MARKDOWN_LAN_BASE_URL=http://shopme.local:11434
MARKDOWN_LAN_MODEL=qwen3.6:latest
MARKDOWN_LAN_API_KEY=
MARKDOWN_LAN_THINKING=false
MARKDOWN_LAN_MAX_OUTPUT_TOKENS=16384
MARKDOWN_LAN_SSH_HOST=mac96
MARKDOWN_LAN_SSH_ENDPOINT=http://127.0.0.1:11434/api/generate

# Leave both empty to inherit the Codex CLI user default. Set a profile for an
# official or non-official provider declared in ~/.codex/<profile>.config.toml.
MARKDOWN_CODEX_PROFILE=
MARKDOWN_CODEX_MODEL=

# Optional OpenAI-compatible LAN/relay routes selected explicitly with
# MARKDOWN_FORMATTER_ROUTE=lan-openai-chat or lan-openai-responses.
MARKDOWN_OPENAI_COMPATIBLE_BASE_URL=
MARKDOWN_OPENAI_COMPATIBLE_API_KEY=
MARKDOWN_OPENAI_COMPATIBLE_MODEL=
